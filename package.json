{
  "name": "music-lab-studio",
  "productName": "Music Lab Studio",
  "version": "1.0.0",
  "description": "A friendly grid-based song maker with multi-track sequencing, patterns, effects and export. Runs in the browser or as a desktop app.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "standalone": "node scripts/bundle-standalone.mjs",
    "icon": "node scripts/make-icon.mjs",
    "prepack": "npm run standalone",
    "electron": "npm run standalone && electron .",
    "dist:win": "npm run standalone && electron-builder --win nsis portable --publish never",
    "dist:win:zip": "npm run standalone && electron-builder --win zip --publish never -c.win.signAndEditExecutable=false",
    "dist:mac": "npm run standalone && electron-builder --mac --publish never",
    "dist:linux": "npm run standalone && electron-builder --linux AppImage --publish never"
  },
  "keywords": [
    "music",
    "sequencer",
    "song-maker",
    "web-audio",
    "daw"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zdstudios.musiclabstudio",
    "productName": "Music Lab Studio",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "build/standalone.html",
      "index.html",
      "src/**/*",
      "assets/icon.*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "artifactName": "MusicLabStudio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Music Lab Studio"
    },
    "portable": {
      "artifactName": "MusicLabStudio-${version}-portable.exe"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Audio",
      "target": [
        "AppImage"
      ]
    }
  },
  "author": "ZD Studios"
}
